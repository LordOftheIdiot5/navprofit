# NavProfit — Environment Variables
# Copy this file to .env only if you want install-wide fallback keys.
# The normal path is: each operator pastes their own keys in Settings.
# NEVER commit .env to git

# Optional fallbacks for the person who installed this server.
# Leave blank so each user connects OilPrice / Claude themselves.
OIL_PRICE_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Cookie signing (auto-generated into data/.session-secret if omitted)
SESSION_SECRET=

PORT=3000
NODE_ENV=development
