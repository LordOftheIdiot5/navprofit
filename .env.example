# NavProfit — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git
#
# The current prototype stores the AIS key in the browser
# (Settings → AIS connection). These variables are for a
# future server build.

# AIS vessel tracking (aisstream.io)
# Get a free key at: https://aisstream.io
AIS_API_KEY=

# Bunker fuel prices (oilpriceapi.com)
# Get key at: https://www.oilpriceapi.com
OIL_PRICE_API_KEY=

# Exchange rates (exchangerate-api.com)
# Free tier: https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=

# Anthropic Claude API (invoice extraction)
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# App config
PORT=3000
NODE_ENV=development
