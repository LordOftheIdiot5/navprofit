# NavProfit — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git
#
# Run: cp .env.example .env && npm start
# Keys stay on the server. The browser never sees them.

# AIS vessel tracking still uses a browser key (Settings → AIS).
# Optional server copy is unused today.
AIS_API_KEY=

# Bunker fuel prices (oilpriceapi.com)
# 7-day trial at https://docs.oilpriceapi.com — no card for trial
OIL_PRICE_API_KEY=

# Invoice extraction (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional override
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Exchange rates use the free open.er-api.com feed (no key).
EXCHANGE_RATE_API_KEY=

# Cookie signing (auto-generated into data/.session-secret if omitted)
SESSION_SECRET=

PORT=3000
NODE_ENV=development
